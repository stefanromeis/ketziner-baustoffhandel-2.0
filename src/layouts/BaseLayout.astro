---
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';
import social from '../assets/social.jpg';
import { contact, productCategories } from '../data/site';
import { formatTime, schedule } from '../utils/openingHours';
import { base } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex: pageNoindex = false } = Astro.props;

const noindex = pageNoindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(social.src, Astro.site);

const schemaDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const business = {
  '@context': 'https://schema.org',
  '@type': 'HardwareStore',
  name: contact.name,
  alternateName: ['Ketziner Baustoffhandel', 'Ketziner-Baustoffhandel'],
  url: new URL(base, Astro.site),
  image: socialImageUrl,
  telephone: contact.phoneHref.replace('tel:', ''),
  faxNumber: '+49 33233 746287',
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: contact.postalCode,
    addressLocality: contact.locality,
    addressRegion: 'Brandenburg',
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: contact.lat, longitude: contact.lng },
  hasMap: contact.googlePlaceHref,
  foundingDate: '1996',
  areaServed: 'Havelland',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Sortiment',
    itemListElement: productCategories.map((category) => ({
      '@type': 'OfferCatalog',
      name: category.name,
      description: category.examples,
    })),
  },
  openingHoursSpecification: Object.entries(schedule).flatMap(([day, ranges]) =>
    ranges.map(([opens, closes]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: schemaDays[Number(day)],
      opens: formatTime(opens),
      closes: formatTime(closes),
    })),
  ),
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#121417" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Ketziner Baustoffhandel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body class="min-h-screen w-full bg-paper font-sans text-ink">
    <slot />
  </body>
</html>
