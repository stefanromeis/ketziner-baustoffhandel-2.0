---
import logo from '../data/logo.json';
import { base } from '../utils/paths';

interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<a href={`${base}#top`} class="block shrink-0" aria-label="Ketziner Baustoffhandel – Startseite">
  <svg viewBox={logo.viewBox} class="h-[52px] w-auto" aria-hidden="true">
    <path d={logo.sail} fill={logo.color}></path>
    <path d={logo.wave} fill={logo.color}></path>
    <g fill={inverted ? '#ffffff' : '#121417'}>
      {logo.lines.map((line) => <path transform={line.tr} d={line.d}></path>)}
    </g>
  </svg>
</a>
