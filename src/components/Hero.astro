---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Navigation from '@lucide/astro/icons/navigation';
import betrieb from '../assets/betrieb.jpg';
import GoogleRating from './GoogleRating.astro';
import { advantages, contact } from '../data/site';
---

<section id="top" aria-labelledby="hero-title" class="bg-paper">
  <div class="mx-auto max-w-7xl px-5 pb-14 pt-5 lg:px-8 lg:pb-20 lg:pt-8">
    <div class="relative">
      <Image
        src={betrieb}
        alt="Verkaufsgebäude des Ketziner Baustoffhandels am Mühlenweg in Ketzin/Havel mit Dachziegeln, Pflastersteinen und Gabelstapler"
        widths={[640, 787]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        priority
        class="aspect-[2/1] w-full rounded-lg object-cover sm:aspect-[787/264]"
      />
      <div class="absolute bottom-6 left-6 hidden rounded-md bg-ink px-4 py-3 text-white sm:block">
        <p class="text-xs text-white/60">Direkt in Ketzin</p>
        <p class="font-display text-lg font-bold uppercase">{contact.street}</p>
      </div>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <div class="lg:col-span-6">
        <h1 id="hero-title" class="text-sm font-semibold text-brand-dark">Baustoffhandel &amp; Handwerkerfachmarkt in Ketzin/Havel</h1>
        <p class="mt-4 font-display text-[56px] font-extrabold uppercase leading-[0.88] tracking-tight text-ink sm:text-[76px] lg:text-[88px]">
          Sie bauen.
          <span class="block text-brand">Wir liefern.</span>
        </p>
      </div>
      <div class="lg:col-span-6">
        <p class="max-w-xl text-lg leading-relaxed text-muted">
          Als Baustoffhandel und Handwerkerfachmarkt im Havelland stehen wir Ihnen in allen Fragen zu Bau, Renovierung und
          Modernisierung zur Seite. Baumaterialien, Werkzeuge und Geräte in Markenqualität für alle Gewerke, mit Lieferung bis auf die
          Baustelle.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#sortiment"
            class="inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3.5 font-semibold text-white transition-colors duration-150 hover:bg-ink-soft"
          >
            Sortiment ansehen
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a
            href={contact.mapsHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-ink/20 px-5 py-3.5 font-semibold text-ink transition-colors duration-150 hover:border-ink"
          >
            <Navigation class="h-4 w-4" aria-hidden="true" />
            Anfahrt
          </a>
        </div>
        <div class="mt-5">
          <GoogleRating />
        </div>
      </div>
    </div>
  </div>

  <div class="border-y border-line">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 px-5 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
      {
        advantages.map((item, i) => (
          <li
            class:list={[
              'py-6 sm:pr-6',
              i > 0 && 'border-t border-line sm:border-t-0',
              i % 2 === 1 && 'sm:border-l sm:pl-6',
              i >= 2 && 'sm:border-t lg:border-t-0',
              i === 2 && 'lg:border-l lg:pl-6',
            ]}
          >
            <p class="font-display text-lg font-bold uppercase text-ink">{item.title}</p>
            <p class="mt-1 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
