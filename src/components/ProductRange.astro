---
import { Image } from 'astro:assets';
import Download from '@lucide/astro/icons/download';
import sortiment from '../assets/sortiment.jpg';
import { productCategories } from '../data/site';
---

<section id="sortiment" aria-labelledby="sortiment-title" class="bg-paper py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-32">
        <h2 id="sortiment-title" class="font-display text-5xl font-extrabold uppercase leading-[0.9] text-ink">
          Unser Sortiment
        </h2>
        <p class="mt-5 max-w-sm text-muted">
          Vom Fundament bis zum Dachfirst – alles, was Profis und Bauherren brauchen. Vieles sofort ab Lager.
        </p>
        <Image
          src={sortiment}
          alt="Porenbetonsteine, Mörtelsäcke und Dämmrollen im Lager"
          widths={[400, 768]}
          sizes="(min-width: 640px) 384px, 100vw"
          class="mt-8 aspect-[4/5] w-full max-w-sm rounded-lg object-cover"
        />
      </div>
    </div>

    <div class="lg:col-span-7">
      <ul class="border-t border-ink">
        {
          productCategories.map((cat) => (
            <li class="grid items-baseline gap-x-8 gap-y-1 border-b border-line py-6 sm:grid-cols-[15rem_1fr]">
              <h3 class="font-display text-2xl font-bold uppercase text-ink">{cat.name}</h3>
              <p class="text-[15px] text-muted">{cat.examples}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col gap-4 rounded-lg bg-paper-deep p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-semibold text-ink">Aktuelle Preisliste</p>
          <p class="text-sm text-muted">Alle Standardartikel mit Preisen als PDF.</p>
        </div>
        <a
          href="#"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md bg-ink px-5 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-ink-soft"
        >
          <Download class="h-4 w-4" aria-hidden="true" />
          Preisliste laden
        </a>
      </div>
    </div>
  </div>
</section>
