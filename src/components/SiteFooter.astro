---
import Logo from './Logo.astro';
import { contact, footerLinks } from '../data/site';
import { base } from '../utils/paths';
---

<footer class="bg-ink text-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-12 md:flex-row md:items-end md:justify-between lg:px-8">
    <div>
      <Logo inverted />
      <p class="mt-4 text-sm text-white/60">
        {contact.street} · {contact.city} · {contact.phone}
      </p>
    </div>
    <nav aria-label="Rechtliches">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          footerLinks.map((l) => (
            <li>
              <a href={`${base}${l.href}`} class="text-white/70 transition-colors duration-150 hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-ink-line">
    <p class="mx-auto max-w-7xl px-5 py-5 text-xs text-white/50 lg:px-8">
      © <span data-current-year>{new Date().getFullYear()}</span>{' '}
      {contact.name}
    </p>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-current-year]').forEach((element) => {
    element.textContent = String(new Date().getFullYear());
  });
</script>
