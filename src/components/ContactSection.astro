---
import Map from '@lucide/astro/icons/map';
import Mail from '@lucide/astro/icons/mail';
import Navigation from '@lucide/astro/icons/navigation';
import Phone from '@lucide/astro/icons/phone';
import Smartphone from '@lucide/astro/icons/smartphone';
import GoogleRating from './GoogleRating.astro';
import OpenBadge from './OpenBadge.astro';
import anfahrtsskizze from '../assets/anfahrtsskizze.jpg';
import { contact, openingHours } from '../data/site';
---

<section id="kontakt" aria-labelledby="kontakt-title" class="border-t border-line bg-paper-deep py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-5">
      <h2 id="kontakt-title" class="font-display text-5xl font-extrabold uppercase leading-[0.9] text-ink">Besuchen Sie uns</h2>
      <address class="mt-6 text-lg not-italic text-ink">
        {contact.name}
        <br />
        {contact.street}
        <br />
        {contact.city}
      </address>

      <div class="mt-6">
        <GoogleRating />
      </div>

      <ul class="mt-8 space-y-3">
        <li>
          <a href={contact.phoneHref} class="group inline-flex items-center gap-3 text-ink">
            <Phone class="h-5 w-5 text-brand-dark" aria-hidden="true" />
            <span class="font-display text-2xl font-bold group-hover:text-brand-dark">{contact.phone}</span>
          </a>
        </li>
        <li>
          <a href={contact.mobileHref} class="inline-flex items-center gap-3 text-ink hover:text-brand-dark">
            <Smartphone class="h-5 w-5 text-brand-dark" aria-hidden="true" />
            Mobil {contact.mobile}
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-3 text-ink hover:text-brand-dark">
            <Mail class="h-5 w-5 text-brand-dark" aria-hidden="true" />
            {contact.email}
          </a>
        </li>
      </ul>

      <div class="mt-10 rounded-lg bg-paper p-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="font-display text-xl font-bold uppercase text-ink">Öffnungszeiten</h3>
          <span class="text-sm text-ink">
            <OpenBadge />
          </span>
        </div>
        <dl class="mt-4 divide-y divide-line">
          {
            openingHours.map((row) => (
              <div
                class="group flex justify-between gap-4 py-2.5 text-[15px] text-muted data-[today=true]:font-semibold data-[today=true]:text-ink"
                data-opening-days={row.days.join(',')}
              >
                <dt>
                  {row.label}
                  <span class="ml-2 hidden text-xs font-semibold text-brand-dark group-data-[today=true]:inline">heute</span>
                </dt>
                <dd class="whitespace-nowrap">{row.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 text-sm text-muted">Mittagspause Mo – Fr: 13:00 – 13:30 Uhr</p>
      </div>
    </div>

    <div class="flex flex-col lg:col-span-7">
      <div class="relative min-h-[380px] flex-1 overflow-hidden rounded-lg border border-line bg-paper">
        <iframe
          title="Karte: Ketziner Baustoffhandel, Am Mühlenweg, Ketzin"
          src="https://www.openstreetmap.org/export/embed.html?bbox=12.833%2C52.471%2C12.874%2C52.489&layer=mapnik&marker=52.4797413%2C12.8537046"
          class="absolute inset-0 h-full w-full grayscale-[30%]"
          loading="lazy"></iframe>
      </div>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a
          href={contact.mapsHref}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-ink hover:text-brand-dark"
        >
          <Navigation class="h-4 w-4" aria-hidden="true" />
          Route mit Google Maps
        </a>
        <a href={anfahrtsskizze.src} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 font-semibold text-ink hover:text-brand-dark">
          <Map class="h-4 w-4" aria-hidden="true" />
          Anfahrtsskizze
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const today = String(new Date().getDay());
  document.querySelectorAll<HTMLElement>('[data-opening-days]').forEach((row) => {
    if (row.dataset.openingDays?.split(',').includes(today)) row.dataset.today = 'true';
  });
</script>
