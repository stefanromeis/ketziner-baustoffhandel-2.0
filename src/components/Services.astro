---
import { Image } from 'astro:assets';
import Truck from '@lucide/astro/icons/truck';
import fuhrpark from '../assets/fuhrpark.jpg';
import { fleet, services } from '../data/site';
---

<section id="leistungen" aria-labelledby="leistungen-title" class="bg-ink py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="leistungen-title" class="font-display text-5xl font-extrabold uppercase leading-[0.9] lg:col-span-6 lg:text-6xl">
        Mehr als
        <span class="block text-brand">nur Material</span>
      </h2>
      <p class="max-w-md text-white/70 lg:col-span-5 lg:col-start-8">
        Wir begleiten Ihr Projekt von der ersten Mengenberechnung bis zur letzten Palette auf der Baustelle.
      </p>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-lg bg-ink-line sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <li class="flex flex-col bg-ink p-6 lg:p-7">
            <h3 class="font-display text-xl font-bold uppercase">{s.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/65">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div id="fuhrpark" class="mt-20 grid gap-10 lg:grid-cols-12 lg:items-center">
      <Image
        src={fuhrpark}
        alt="Blauer LKW mit Ladekran und orangefarbener Kipper auf dem Hof"
        widths={[640, 960, 1200]}
        sizes="(min-width: 1280px) 720px, (min-width: 1024px) 58vw, 100vw"
        class="aspect-[4/3] w-full rounded-lg object-cover lg:col-span-7"
      />
      <div class="lg:col-span-5">
        <div class="flex items-center gap-2 text-brand">
          <Truck class="h-5 w-5" aria-hidden="true" />
          <span class="text-sm font-semibold">Unser Fuhrpark</span>
        </div>
        <h3 class="mt-3 font-display text-4xl font-extrabold uppercase leading-[0.95]">Geliefert, wo Sie bauen</h3>
        <dl class="mt-8 divide-y divide-ink-line border-y border-ink-line">
          {
            fleet.map((f) => (
              <div class="py-4">
                <dt class="font-semibold">{f.name}</dt>
                <dd class="text-sm text-white/60">{f.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
