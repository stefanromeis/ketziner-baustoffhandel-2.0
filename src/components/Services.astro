import { services } from '../data/site';
---

<section id="leistungen" aria-labelledby="leistungen-title" class="bg-ink py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="leistungen-title" class="font-display text-5xl font-extrabold uppercase leading-[0.9] lg:col-span-6 lg:text-6xl">
        Mehr als
        <span class="block text-brand">nur Material</span>
      </h2>
      <p class="max-w-md text-white/70 lg:col-span-5 lg:col-start-8">
        Wir begleiten Ihr Projekt von der Beratung bis zur letzten Palette auf der Baustelle.
      </p>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-lg bg-ink-line sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li class="flex flex-col bg-ink p-6 lg:p-7">
            <h3 class="font-display text-xl font-bold uppercase">{s.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/65">{s.text}</p>
          </li>
        ))
      }
    </ul>

