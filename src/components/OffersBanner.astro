---
import ArrowRight from '@lucide/astro/icons/arrow-right';
---

<section id="angebote" aria-labelledby="angebote-title" class="bg-brand text-white">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 lg:grid-cols-12 lg:items-center lg:px-8 lg:py-16">
    <div class="lg:col-span-8">
      <h2 id="angebote-title" class="font-display text-4xl font-extrabold uppercase leading-[0.92] sm:text-5xl">
        Aktionsflyer: Angebote des Monats
      </h2>
      <p class="mt-4 max-w-xl text-white/90">
        Ausgewählte Baustoffe und Werkzeuge zu Sonderpreisen – nur solange der Vorrat reicht.
      </p>
    </div>
    <div class="lg:col-span-4 lg:text-right">
      <a
        href="https://www.ketzinerbaustoffhandel.de/flyer.pdf"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 whitespace-nowrap rounded-md bg-ink px-6 py-4 font-semibold text-white transition-colors duration-150 hover:bg-ink-soft"
      >
        Flyer ansehen
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
