---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ProductRange from '../components/ProductRange.astro';
import Services from '../components/Services.astro';
import OffersBanner from '../components/OffersBanner.astro';
import AboutTeam from '../components/AboutTeam.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Baustoffhandel in Ketzin/Havel | Ketziner Baustoffhandel Mier"
  description="Baustoffhandel und Handwerkerfachmarkt in Ketzin/Havel im Havelland: Baustoffe, Werkzeuge, Schüttgüter und Brennstoffe, mit Beratung und Lieferung per Kran-LKW."
>
  <SiteHeader />
  <main>
    <Hero />
    <Services />
    <ProductRange />
    <OffersBanner />
    <AboutTeam />
    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
